# Supabase cloud sync (optional). Copy this file to .env.local and fill in the
# two values from your Supabase project → Settings → API.
#
# The anon key is a PUBLIC client key (not a secret) — it's safe to ship in the
# app. Data is protected by Supabase Row Level Security, not by hiding this key.
#
# Without these, the app still works fully offline/local — cloud sync just stays off.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
